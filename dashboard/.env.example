# Cyberspace Dashboard — Environment Variables
# Copy this file to .env and fill in values as needed.
#
# OFFLINE / LOCAL MODE: none of the variables below are required.
# The dashboard works fully without any configuration — leave everything blank
# and it will use local file storage with no authentication.
# The variables here are only needed for Vercel / cloud deployments.

# --- Turso (libSQL) database ---
# Required for Vercel deployments (RSS feed + user config storage).
# Omit for local use; the server falls back to local file storage automatically.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- GitHub OAuth ---
# Required for Vercel deployments (user sign-in and per-user feed config).
# Omit for local use; the dashboard runs without authentication.
# Register an OAuth app at https://github.com/settings/developers
# and set the callback URL to https://your-domain/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Secret used to sign JWT session cookies — required when GitHub OAuth is configured.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Comma-separated list of GitHub user IDs to grant admin role (optional).
# Find your ID at https://api.github.com/users/<your-username>
ADMIN_GITHUB_IDS=

# HTTP port — used when no TLS certs are present, or as the redirect listener when HTTPS is active (default: 3000)
HTTP_PORT=3000

# HTTPS port — used when TLS certificates are present in dashboard/certs/ (default: 4444)
HTTPS_PORT=4444

# Optional map center for dashboard startup (lat,lng)
MAP_CENTER=20,0
